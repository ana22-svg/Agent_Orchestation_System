# Agent Orchestration System - Environment Configuration

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model Configuration
PLANNING_MODEL=gpt-4-turbo
SPECIALIST_MODEL=gpt-4-turbo
REVIEW_MODEL=gpt-4-turbo

# Orchestration Settings
PLAN_CONFIDENCE_THRESHOLD=0.6
MAX_RETRIES=2
TIMEOUT=300

# Tool Configuration
ENABLE_WEB_SEARCH=true
ENABLE_CODE_EXECUTION=true
SANDBOX_TIMEOUT=30

# Database (Phase 2+)
DATABASE_URL=postgresql://localhost/agent_system
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=INFO
LOG_FILE=agent_system.log

# UI Ports
STREAMLIT_PORT=8501
TRACE_EXPLORER_PORT=8502

# Cost Tracking
TRACK_COSTS=true
COST_ALERT_THRESHOLD=10.0

# Execution Mode
DEBUG_MODE=false
MOCK_EXECUTION=false
